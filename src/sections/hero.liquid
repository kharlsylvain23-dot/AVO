<section class="hero container">
  <div class="hero-content">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="lead">{{ section.settings.subheading }}</p>

    {% if section.settings.featured_product != blank %}
      {% assign featured_product = section.settings.featured_product %}
      <div class="hero-product-summary">
        <strong>{{ featured_product.title }}</strong>
        <span>{{ featured_product.price | money }}</span>
      </div>
      <a class="btn primary" href="{{ featured_product.url }}">Shop product</a>
    {% else %}
      <a class="btn primary" href="/collections/all">Shop now</a>
    {% endif %}
  </div>

  <div class="hero-media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.heading }}
    {% elsif section.settings.featured_product != blank and section.settings.featured_product.featured_image != blank %}
      {{ section.settings.featured_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.featured_product.title }}
    {% else %}
      <div class="placeholder">Product image</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "AVO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AVO Signature Product"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A clear, high-converting brand hero built around one featured product."
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback hero image"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
